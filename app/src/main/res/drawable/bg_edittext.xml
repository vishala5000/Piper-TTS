<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="@color/card2" />
            <stroke
                android:width="2dp"
                android:color="@color/accent" />
            <padding
                android:left="16dp"
                android:top="14dp"
                android:right="16dp"
                android:bottom="14dp" />
        </shape>
    </item>

    <item>
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="@color/card2" />
            <stroke
                android:width="1dp"
                android:color="#30353D" />
            <padding
                android:left="16dp"
                android:top="14dp"
                android:right="16dp"
                android:bottom="14dp" />
        </shape>
    </item>

</selector>
